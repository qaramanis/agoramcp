# Copy to apps/web/.env.local

# --- required ---
DATABASE_URL=postgresql://user:password@ep-example-pooler.eu-central-1.aws.neon.tech/agoramcp?sslmode=require  # pooled, for the app
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-example.eu-central-1.aws.neon.tech/agoramcp?sslmode=require  # direct, for migrations
REQUEST_HASH_SALT=                              # random string, same on both apps

# --- optional: each one overrides a default setting ---
NEXT_PUBLIC_MCP_BASE_URL=        # server address shown on the site
MCP_SERVER_URL=                                 # server address this app calls
PROXY_SECRET=                                   # random string, same as the server's
CRON_SECRET=                                    # random string, lets the Vercel cron in
LOG_RETENTION_DAYS=                             # days to keep the server's warnings and errors
