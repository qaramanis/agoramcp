# Copy to apps/server/.env

# --- required on Vercel, optional locally ---
VERCEL_EXPERIMENTAL_BACKENDS=1  # Vercel build setting, no effect locally
DATABASE_URL=                   # records calls, clients and warnings, keep empty locally
REQUEST_HASH_SALT=              # random string, same as the web app's
PROXY_SECRET=                   # random string, same as the web app's

# --- optional: each one overrides a default setting ---
PORT=                           # port for local runs
HOST=                           # bind address, "::" for IPv6
LOG_LEVEL=                      # debug, info, warn, error or silent
LOG_SLOW_TOOL_MS=               # warn about tool calls slower than this
TOOL_TIMEOUT_MS=                # stop a tool call after this
LOG_TOOL_ARGS=                  # log argument values, for debugging only
CORS_ORIGINS=                   # allowed origins, comma-separated
RATE_LIMIT_PER_MINUTE=          # per caller and source, 0 = off
CACHE_MAX_MB=                   # in-memory cache size
CACHE_MAX_ENTRIES=              # in-memory cache entries
