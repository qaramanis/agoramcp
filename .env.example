# --- server ---
PORT=3000
# Bind address. "::" is dual-stack and required where the host's private
# network is IPv6-only (Railway); the public edge works either way.
# HOST=0.0.0.0
LOG_LEVEL=info
# A successful tool call slower than this many milliseconds is logged as a warning.
LOG_SLOW_TOOL_MS=10000
# How long one tool call may take in all, in milliseconds, before it is stopped
# and answered as upstream_timeout. MCP clients commonly give up at a minute.
TOOL_TIMEOUT_MS=60000

# Whether a tool's argument values go on its log line; off, only their names
# do. The privacy page promises arguments are not logged (a VAT number is
# personal data, for a sole trader), so switch it on only to debug, and off
# again after.
LOG_TOOL_ARGS=false
# Where the server records each call's outcome for the status history: the
# web app's database, its pooled string (see "web: database" below). Unset,
# outcomes are logged and nothing else.
# DATABASE_URL=

# Comma-separated origins allowed to call the MCP endpoints. "*" in dev.
CORS_ORIGINS=*

# Requests per minute, per requester, per source. 0 disables rate limiting.
RATE_LIMIT_PER_MINUTE=60

# A requester is a salted hash of the caller's address, the one the web app
# files country requests under, so set REQUEST_HASH_SALT (below) on the server
# too, to the same value. Unset, the limiter keys on the address itself.
# PROXY_SECRET lets the web app's /live proxy name its visitor, so the limit
# counts the visitor rather than the site: any long random string, the same on
# both apps. Unset on either, every playground call counts against the site.
# PROXY_SECRET=

# What the in-memory cache may hold, in megabytes, before it evicts the least
# recently used entries. One entry can be a whole 8 MB file from read_resource.
CACHE_MAX_MB=256

# Redis is optional. Unset -> in-memory cache (fine for a single instance).
# REDIS_URL=redis://localhost:6379

# --- web ---
# The base URL the /mcp and /api pages print in their snippets. Inlined at build
# time and shown to the reader, so it must be an address they can reach.
NEXT_PUBLIC_MCP_BASE_URL=http://localhost:3000

# Where apps/web's /live console forwards its calls. Server-side only: the
# browser talks to /api/mcp, never to the MCP server directly.
MCP_SERVER_URL=http://127.0.0.1:3000

# --- source credentials ---
# ENTSO-E transparency platform (energy) — https://transparency.entsoe.eu
# ENTSOE_TOKEN=
# ΓΕΜΗ (business registry) — application required, human approval
# GEMI_KEY=

# --- web: database ---
# Neon Postgres, for /country. The pooled string serves the app; the direct
# one is for migrations and seeders, which hold a session the pooler would
# not. Both are in the Neon dashboard under "Connection string".
DATABASE_URL=postgresql://user:password@ep-example-pooler.eu-central-1.aws.neon.tech/agoramcp?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-example.eu-central-1.aws.neon.tech/agoramcp?sslmode=require

# Salts the requester hash, so no address can be recovered from the requests
# table. Any long random string — and the same one on every deployment and on
# both apps (the server's rate limiter counts the same hash), or every visitor
# becomes new and can ask for a country twice.
REQUEST_HASH_SALT=

# Lets Vercel's cron call /api/cron/status, which checks every registry every
# ten minutes and keeps the status history. Any long random string; Vercel
# sends it back as a bearer token, and nothing else is let in.
CRON_SECRET=
