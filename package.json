{
  "name": "agoramcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @agoramcp/server dev",
    "dev:web": "pnpm --filter @agoramcp/web dev",
    "build:web": "pnpm --filter @agoramcp/web build",
    "start": "pnpm --filter @agoramcp/server start",
    "start:web": "pnpm --filter @agoramcp/web start",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^5.9.0"
  },
  "packageManager": "pnpm@11.24.0"
}
